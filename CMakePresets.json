{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "displayName": "Debug (Bootloader slot)",
            "description": "Debug build for the SBSFU bootloader slot: FLASH @ 0x08010400, VTOR 0x08010400",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "displayName": "Release (Bootloader slot)",
            "description": "Release build for the SBSFU bootloader slot: FLASH @ 0x08010400, VTOR 0x08010400. This is the image that gets signed.",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "Debug-BareMetal",
            "inherits": "default",
            "displayName": "Debug (Bare metal)",
            "description": "Standalone debug build, no bootloader: FLASH @ 0x08000000",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BARE_METAL": "ON"
            }
        },
        {
            "name": "Release-BareMetal",
            "inherits": "default",
            "displayName": "Release (Bare metal)",
            "description": "Standalone release build, no bootloader: FLASH @ 0x08000000",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BARE_METAL": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Debug-BareMetal",
            "configurePreset": "Debug-BareMetal"
        },
        {
            "name": "Release-BareMetal",
            "configurePreset": "Release-BareMetal"
        }
    ]
}
